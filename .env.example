# Maverick Voice — dev-mode API key fallback seed.
#
# Keys are normally entered in the Settings UI and stored encrypted via
# Electron safeStorage (OS keychain / DPAPI). These .env values are a
# READ-ONLY dev fallback: if no encrypted key is stored for a provider,
# keyStore seeds from the matching variable below. They are never written
# back to disk. .env is gitignored; this .env.example is committed.

# Groq — speech-to-text (whisper-large-v3-turbo)
GROQ_API_KEY=

# OpenAI — LLM transform (OpenAI-compatible chat/completions)
OPENAI_API_KEY=

# OpenRouter — LLM transform (OpenAI-compatible chat/completions)
OPENROUTER_API_KEY=
