<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 needs JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Microphone capture. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- osascript System Events paste path. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- v1's disable-library-validation was for whisper/llama dylibs that no
       longer exist — deliberately dropped (LEGACY-ISSUES A8). -->
</dict>
</plist>
