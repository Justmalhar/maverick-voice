# Maverick Voice — release / R2 upload credentials
#
# Copy to .env.release and source before local releases:
#   cp .env.release.example .env.release
#   set -a && source .env.release && set +a
#
# NEVER commit .env.release — it contains secrets.

# ── Cloudflare R2 (required for upload-r2.mjs) ─────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Account-scoped endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=

# Public URL for the bucket (r2.dev subdomain or custom domain, NO trailing slash).
# Used by: electron-builder publish config, upload-r2 downloads.json, in-app updater.
R2_PUBLIC_URL=

# ── Apple notarization (required for signed macOS release) ───────────────────
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Override artifact directory (default: ./release)
# RELEASE_DIR=./release
